nas_servers = {
  default = {
    cluster_uuid = "88888888-8888-8888-8888-888888888888"
    hostname     = "nas.example.com"
    vendor_type  = "NAS_VENDOR_TYPE_GENERIC"
    generic_parameters = {
      has_nfs_support      = true
      has_smb_support      = true
      nfs_pseudo_fs_prefix = "/exports"
      smb_credentials = {
        username_credential = "nas_generic_smb_username"
        password_credential = "nas_generic_smb_password"
      }
    }
  }
  powerscale = {
    cluster_uuid = "00000000-0000-0000-0000-000000000001"
    hostname     = "powerscale.example.invalid"
    vendor_type  = "NAS_VENDOR_TYPE_ISILON"
    api_credentials = {
      api_username_credential    = "powerscale_api_username"
      api_password_credential    = "powerscale_api_password"
      api_certificate_credential = "powerscale_api_certificate"
      certificate_id             = "00000000-0000-0000-0000-000000000010"
    }
    smb_credentials = {
      username_credential = "powerscale_smb_username"
      password_credential = "powerscale_smb_password"
    }
    is_isilon_changelist_enabled = true
  }
}
nas_shares = {
  engineering_nfs = {
    export_point   = "/engineering"
    share_type     = "CREATE_NAS_SHARE_INPUT_SHARE_TYPE_NFS"
    nas_server_key = "default"
  }
  finance_smb = {
    export_point   = "finance"
    share_type     = "CREATE_NAS_SHARE_INPUT_SHARE_TYPE_SMB"
    nas_server_key = "powerscale"
    credentials = {
      username_credential = "finance_share_username"
      password_credential = "finance_share_password"
    }
  }
}
nas_configured_share_sla_domain_keys = {
  engineering_nfs = "standard"
  finance_smb      = "critical"
}
