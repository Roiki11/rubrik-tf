# Replace every example name, ID, endpoint, and credential with values from
# your Rubrik environment before using this file. Store each referenced field
# at the configured KV v2 mount/path; authenticate to Vault using its standard
# VAULT_ADDR and VAULT_TOKEN (or another supported Vault auth method).
rubrik_graphql_url = "https://<your-rsc-tenant>/api/graphql"
vault_credential_refs = {
  rubrik_api_token              = { mount = "secret", path = "rubrik/terraform", key = "rubrik_api_token" }
  nas_generic_smb_username      = { mount = "secret", path = "rubrik/terraform", key = "nas_generic_smb_username" }
  nas_generic_smb_password      = { mount = "secret", path = "rubrik/terraform", key = "nas_generic_smb_password" }
  powerscale_api_username       = { mount = "secret", path = "rubrik/terraform", key = "powerscale_api_username" }
  powerscale_api_password       = { mount = "secret", path = "rubrik/terraform", key = "powerscale_api_password" }
  powerscale_api_certificate    = { mount = "secret", path = "rubrik/terraform", key = "powerscale_api_certificate" }
  powerscale_smb_username       = { mount = "secret", path = "rubrik/terraform", key = "powerscale_smb_username" }
  powerscale_smb_password       = { mount = "secret", path = "rubrik/terraform", key = "powerscale_smb_password" }
  finance_share_username        = { mount = "secret", path = "rubrik/terraform", key = "finance_share_username" }
  finance_share_password        = { mount = "secret", path = "rubrik/terraform", key = "finance_share_password" }
  netapp_username               = { mount = "secret", path = "rubrik/terraform", key = "netapp_username" }
  netapp_password               = { mount = "secret", path = "rubrik/terraform", key = "netapp_password" }
  s3_access_key                 = { mount = "secret", path = "rubrik/terraform", key = "s3_access_key" }
  s3_secret_key                 = { mount = "secret", path = "rubrik/terraform", key = "s3_secret_key" }
  vcenter_username              = { mount = "secret", path = "rubrik/terraform", key = "vcenter_username" }
  vcenter_password              = { mount = "secret", path = "rubrik/terraform", key = "vcenter_password" }
  vcenter_ca_certificate        = { mount = "secret", path = "rubrik/terraform", key = "vcenter_ca_certificate" }
  esxi_username                 = { mount = "secret", path = "rubrik/terraform", key = "esxi_username" }
  esxi_password                 = { mount = "secret", path = "rubrik/terraform", key = "esxi_password" }
  proxmox_api_token              = { mount = "secret", path = "rubrik/terraform", key = "proxmox_api_token" }
  proxmox_ca_certificate         = { mount = "secret", path = "rubrik/terraform", key = "proxmox_ca_certificate" }
  tape_primary_encryption        = { mount = "secret", path = "rubrik/terraform", key = "tape_primary_encryption" }
  tape_primary_password          = { mount = "secret", path = "rubrik/terraform", key = "tape_primary_password" }
  tape_primary_username          = { mount = "secret", path = "rubrik/terraform", key = "tape_primary_username" }
  tape_recovery_encryption       = { mount = "secret", path = "rubrik/terraform", key = "tape_recovery_encryption" }
  tape_recovery_password         = { mount = "secret", path = "rubrik/terraform", key = "tape_recovery_password" }
  tape_recovery_username         = { mount = "secret", path = "rubrik/terraform", key = "tape_recovery_username" }
}
