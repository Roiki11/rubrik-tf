  postgres-analytics  = "critical"
}
linux_fileset_cluster_uuid = "00000000-0000-0000-0000-000000000001"
linux_fileset_templates = {
  application = {
    includes                     = ["/opt/application", "/var/lib/application"]
    excludes                     = ["/var/lib/application/cache"]
    exceptions                   = ["/var/lib/application/cache/keep"]
    pre_backup_script            = "#!/bin/sh\necho pre-backup"
    post_backup_script           = "#!/bin/sh\necho post-backup"
    backup_script_error_handling = "continue"
    backup_script_timeout        = 300
    fileset_options = {
      allow_backup_hidden_folders_in_network_mounts = false
      allow_backup_network_mounts                   = true
    }
  }
}
linux_fileset_assignments = {
  application_server = {
    host_name                 = "app-server-01.example.invalid"
    template_name             = "application"
    enable_hardlink_support   = true
    enable_symlink_resolution = false
  }
  batch_server = {
    host_name                 = "batch-server-01.example.invalid"
    template_name             = "application"
    enable_hardlink_support   = false
    enable_symlink_resolution = true
  }
}
linux_fileset_sla_domain_keys = {
  application_server = "standard"
  batch_server       = "critical"
}
