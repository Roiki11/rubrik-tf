sla_domains = {
  standard = {
    name        = "Terraform standard protection"
    description = "Standard workload protection managed by Terraform"
    object_types = [
      "POSTGRES_DB_CLUSTER_OBJECT_TYPE",
      "VSPHERE_OBJECT_TYPE",
      "NAS_OBJECT_TYPE",
      "FILESET_OBJECT_TYPE",
      "K8S_OBJECT_TYPE",
      "KUPR_OBJECT_TYPE",
      "PROXMOX_OBJECT_TYPE",
      "NCD_OBJECT_TYPE",
    ]
    snapshot_schedule = {
      daily = {
        basicSchedule = {
          frequency     = 1
          retention     = 30
          retentionUnit = "DAYS"
        }
      }
    }
    archival_specs = [
      {
        archivalGroupId = "00000000-0000-0000-0000-000000000002"
        threshold       = 30
        thresholdUnit   = "DAYS"
        frequencies     = ["DAYS"]
        archivalTieringSpecInput = {
          isInstantTieringEnabled        = false
          minAccessibleDurationInSeconds = 2592000
          coldStorageClass               = "AWS_GLACIER"
          shouldTierExistingSnapshots    = false
        }
        archivalLocationToClusterMapping = [
          {
            clusterUuid = "00000000-0000-0000-0000-000000000001"
            locationId  = "00000000-0000-0000-0000-000000000003"
          }
        ]
        isComplianceImmutabilityEnabled = false
      }
    ]
  }
  critical = {
    name         = "Terraform critical protection"
    description  = "Short-retention protection managed by Terraform"
    object_types = ["POSTGRES_DB_CLUSTER_OBJECT_TYPE", "VSPHERE_OBJECT_TYPE", "FILESET_OBJECT_TYPE", "K8S_OBJECT_TYPE", "KUPR_OBJECT_TYPE", "PROXMOX_OBJECT_TYPE", "NCD_OBJECT_TYPE"]
    archival_specs = []
    snapshot_schedule = {
      daily = {
        basicSchedule = {
          frequency     = 1
          retention     = 14
          retentionUnit = "DAYS"
        }
      }
    }
  }
}
