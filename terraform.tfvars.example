classification_analyzers = {
  internal_reference = {
    name                          = "Example internal reference"
    analyzer_type                 = "REGEX"
    risk                          = "HIGH_RISK"
    rule_types                    = ["STRUCTURED", "UNSTRUCTURED"]
    dictionary                    = ["internal", "confidential"]
    dictionary_csv                = null
    structured_dictionary         = ["account_number", "customer_id"]
    regex                         = "REF-[0-9]{8}"
    key_regex                     = "^(account|customer)_"
    structured_value_regex        = "[A-Z]{3}-[0-9]{6}"
    structured_dictionary_csv     = null
    structured_key_dictionary     = ["account_number", "customer_id"]
    structured_key_dictionary_csv = null
    exclude_field_name_pattern    = "^test_"
    exclude_path_pattern          = "/tmp/.*"
    exclude_value_regex           = "^EXAMPLE-"
    proximity_distance            = 20
    proximity_keywords_regex      = "(internal|confidential)"
    tag_id                        = 123
    analyzer_risk_instance = {
      analyzer_id  = "00000000-0000-0000-0000-000000000004"
      risk         = "HIGH_RISK"
      risk_version = 1
    }
    is_inactive = false
  }
  example_dictionary = {
    name                  = "Example dictionary"
    analyzer_type         = "KEYWORD"
    risk                  = "MEDIUM_RISK"
    rule_types            = ["UNSTRUCTURED"]
    dictionary            = ["example-term", "sample-term"]
    dictionary_csv        = "example-term,sample-term"
    structured_dictionary = []
    is_inactive           = false
  }
}
