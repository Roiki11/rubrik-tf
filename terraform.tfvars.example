  standalone_esxi = {
    cluster_uuid                       = "00000000-0000-0000-0000-000000000001"
    hostname                           = "esxi-01.example.invalid"
    username                           = "root"
    password                           = "REPLACE_WITH_ESXI_PASSWORD"
