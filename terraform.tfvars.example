  "application-01",
  "application-02",
]
vsphere_vm_sla_domain_keys = {
  application-01 = "standard"
  application-02 = "critical"
}
vsphere_folder_names = [
  "Production",
  "Development",
]
vsphere_folder_sla_domain_keys = {
